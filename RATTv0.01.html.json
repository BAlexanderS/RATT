window.lockInPairing = function() {
    if (pregnancies.length >= matCapacity) return alert("Nursery full!");
    let sSelectElement = document.getElementById("sel-sire"), dSelectElementA = document.getElementById("sel-damA"), dSelectElementB = document.getElementById("sel-damB"), dSelectElementC = document.getElementById("sel-damC");
    let sId = sSelectElement ? parseInt(sSelectElement.value) : 0, dAId = dSelectElementA ? parseInt(dSelectElementA.value) : 0, dBId = (dSelectElementB && !dSelectElementB.disabled) ? parseInt(dSelectElementB.value) : 0, dCId = (dSelectElementC && !dSelectElementC.disabled) ? parseInt(dSelectElementC.value) : 0;
    if(!sId || !dAId) return alert("Select Buck and Doe A!");
    
    let sire = colony.find(r => r.id === sId), damA = colony.find(r => r.id === dAId);
    
    // Age & Fertility Health Defenses: Checks natural genetic degradation profiles
    let doeMaxAgeLimit = 60;
    let doeFertilityScore = Math.floor((damA.color_qm + damA.coat_qm) / 2);
    if (doeFertilityScore >= 80) doeMaxAgeLimit = 70;
    else if (doeFertilityScore < 45) doeMaxAgeLimit = 52;

    if (damA.age >= doeMaxAgeLimit) {
        return alert("🔒 Breeding Denied: This Doe has reached her age limit. Further breeding carries severe health risks.");
    }

    sire.breeding = true; damA.breeding = true; let typeLabel = "Standard Pair", loopCount = 1, damsList = [damA];
    if (dBId && reputation >= 1000) { let damB = colony.find(r => r.id === dBId); if(damB.age < 60) { damB.breeding = true; typeLabel = "Trio Colony"; loopCount = 2; damsList.push(damB); } }
    if (dCId && reputation >= 4000) { let damC = colony.find(r => r.id === dCId); if(damC.age < 60) { damC.breeding = true; typeLabel = "Quad Harem"; loopCount = 3; damsList.push(damC); } }
    
    let arr = new Array();
    for(let d=0; d<loopCount; d++) {
        let baseCountRoll = Math.floor(Math.random()*4)+3; 
        if (sire.age >= 78) { baseCountRoll = Math.max(1, Math.floor(baseCountRoll * (1.0 - (sire.age - 78) / 100))); }
        if (damsList[d].age >= 45) { baseCountRoll = Math.max(1, Math.floor(baseCountRoll * 0.6)); }

        // Senior Buck Sperm Count Conception Check
        if (sire.age >= 104 && Math.random() < 0.35) {
            console.log("Conception run failed due to senior Buck motility decay factors.");
            continue; 
        }
<!-- PART 5 SECTION A END -->

<!-- PART 5 SECTION B START -->
        for(let i=1; i<=baseCountRoll; i++) {
            let rolledSm = cross(sire.silvermane, damsList[d].silvermane);
            if (rolledSm.filter(x => x === "Sm").length === 2) continue; // Lethal Silvermane Absorption

            let rolledDu = cross(sire.downunder, damsList[d].downunder);
            if (rolledDu.filter(x => x === "Hdu").length === 2) continue; // Lethal Downunder Absorption
            
            let sireRexAlleles = (sire.coat === "Double Rex") ? ["Rex", "Rex"] : (sire.coat === "Rex" ? ["Rex", "re"] : ["re", "re"]);
            let damRexAlleles = (damsList[d].coat === "Double Rex") ? ["Rex", "Rex"] : (damsList[d].coat === "Rex" ? ["Rex", "re"] : ["re", "re"]);
            let childRexRoll = cross(sireRexAlleles, damRexAlleles);
            let parsedCoat = "Standard";
            let activeRexCount = childRexRoll.filter(x => x === "Rex").length;
            if (activeRexCount === 2) parsedCoat = "Double Rex";
            else if (activeRexCount === 1) parsedCoat = "Rex";

            let sireEarAlleles = (sire.ears && sire.ears.length === 2) ? sire.ears : ["Du", "Du"];
            let damEarAlleles = (damsList[d].ears && damsList[d].ears.length === 2) ? damsList[d].ears : ["Du", "Du"];
            let childEarRoll = cross(sireEarAlleles, damEarAlleles);

            let childObj = { 
                id: Math.floor(Math.random()*100000), name: "Offspring #"+Math.floor(Math.random()*900+100), sex: Math.random()<0.5?"Buck ♂":"Doe ♀", age: 3, 
                color: cross(sire.color, damsList[d].color), d_blue: cross(sire.d_blue, damsList[d].d_blue), rb_blue: cross(sire.rb_blue, damsList[d].rb_blue), choc: cross(sire.choc, damsList[d].choc), mink: cross(sire.mink, damsList[d].mink), p_dilute: cross(sire.p_dilute, damsList[d].p_dilute), r_dilute: cross(sire.r_dilute, damsList[d].r_dilute), 
                c: cross(sire.c, damsList[d].c), coat: parsedCoat, ears: childEarRoll, burmese: cross(sire.burmese, damsList[d].burmese), be: cross(sire.be, damsList[d].be), silvermane: rolledSm, harley: cross(sire.harley, damsList[d].harley), bristle: cross(sire.bristle, damsList[d].bristle), 
                downunder: rolledDu, marking_h: cross(sire.marking_h, damsList[d].marking_h), headspot: cross(sire.headspot, damsList[d].headspot), size_dw: cross(sire.size_dw, damsList[d].size_dw), headspot_style: Math.random() < 0.5 ? "headspot" : "blazed", color_qm: blend(sire.color_qm, damsList[d].color_qm), coat_qm: blend(sire.coat_qm, damsList[d].coat_qm), behavior_qm: blend(sire.behavior_qm, damsList[d].behavior_qm),
                cageHome: 1
            };

