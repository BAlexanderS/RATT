        </div>
<!-- PART 1 END -->

<!-- PART 2 START -->
        <div id="scr-breed" class="screen">
            <h3>🔬 Nursery Development Pipeline</h3>
            <div id="mat-cap-ui" style="font-weight:bold; color:#6da374; margin-bottom:6px;">Maternity Racks: 0 / 2 Active</div>
