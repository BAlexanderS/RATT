        function checkGeneticEligibility(rat, type) {
            if (!rat || rat.age < 12 || rat.breeding || rat.inShowCircuit) return false;
            if (type === "open" || type === "seasonal") return true;
            if (type === "self") return rat.color && rat.color.includes("a") && !rat.color.includes("A");
            if (type === "ticked") return rat.color && rat.color.includes("A");
            if (type === "dwarf") return rat.size_dw && rat.size_dw.filter(x => x === 'dw').length === 2;
            if (type === "rex") return rat.coat && rat.coat.includes("Rex");
            if (type === "harley") return rat.harley && rat.harley.filter(x => x === 'hl').length === 2;
            if (type === "silvermane") return rat.silvermane && rat.silvermane.includes("Sm") && rat.silvermane.includes("sm");
            return false;
        }

