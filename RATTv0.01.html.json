            </div>
            
            <h4 style="margin:4px 0;">🛒 Purchase Consumables & Enrichment</h4>
            <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(135px, 1fr)); gap:6px; margin-bottom:10px; max-height:180px; overflow-y:auto; padding:2px;" id="shop-catalog-shelf"></div>

            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:6px; border-top:1px dashed #4a3e3a; padding-top:6px;">
                <span id="market-timer-ui" style="font-size:11px; font-weight:bold; color:#6da374;">🔄 Auto-Restock in: 12 Wks</span>
                <span id="market-ref-ui" style="font-size:11px; opacity:0.8;">Refreshes left: 3 / 3</span>
            </div>
            <button id="manual-refresh-btn" onclick="manualRefreshMarket()" style="margin-bottom:8px; width:100%; padding:10px;">🔄 Force Manual Refresh (💰 50 Shil)</button>
            
