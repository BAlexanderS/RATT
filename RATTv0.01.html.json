function saveGame() {
    try {
        let state = { shillings, reputation, treats, maxCapacity, matCapacity, marketWeeksLeft, manualRefreshesThisPeriod, onboardStage, colony, pregnancies, weaningRack, cages, inventory, breederName, ratteryName, ratteryRegistered, lifetimeBenched, lifetimeBIS, lifetimeFirst, lifetimeSecond, lifetimeThird, wonRibbonsInventory, activeShowcaseRibbons, lastSavedTime: Date.now() };
        localStorage.setItem("rat_a_tap_tap_save_v5", JSON.stringify(state));
    } catch(e) {} refreshUI();
}

function loadGame() {
    try {
        let d = localStorage.getItem("rat_a_tap_tap_save_v5");
        if (d) {
            let p = JSON.parse(d);
            shillings = p.shillings; reputation = p.reputation; treats = p.treats || 0;
            matCapacity = p.matCapacity; marketWeeksLeft = p.marketWeeksLeft; manualRefreshesThisPeriod = p.manualRefreshesThisPeriod;
            onboardStage = p.onboardStage; colony = p.colony; pregnancies = p.pregnancies; weaningRack = p.weaningRack;
            cages = p.cages || cages; inventory = p.inventory || inventory;
            breederName = p.breederName; ratteryName = p.ratteryName; ratteryRegistered = p.ratteryRegistered;
            lifetimeBenched = p.lifetimeBenched || 0; lifetimeBIS = p.lifetimeBIS || 0;
            lifetimeFirst = p.lifetimeFirst || 0; lifetimeSecond = p.lifetimeSecond || 0; lifetimeThird = p.lifetimeThird || 0;
            wonRibbonsInventory = p.wonRibbonsInventory || new Array(); activeShowcaseRibbons = p.activeShowcaseRibbons || [null,null,null];

            if (p.lastSavedTime) {
                let passedWeeks = Math.floor((Date.now() - p.lastSavedTime) / 40000);
                if (passedWeeks > 0) {
                    let steps = Math.min(12, passedWeeks);
                    for (let s = 0; s < steps; s++) {
                        colony.forEach(r => { r.age += 1; }); weaningRack.forEach(r => { r.age += 1; }); pregnancies.forEach(pr => { pr.stage += 1; });
                        inventory.ratFoodBlocks = Math.max(0, inventory.ratFoodBlocks - (colony.length * 10));
                        marketWeeksLeft -= 1;
                    }
                    for (let i = pregnancies.length - 1; i >= 0; i--) {
                        if (pregnancies[i].stage >= 5) {
                            let prg = pregnancies[i]; prg.sire.breeding = false; prg.dam.breeding = false; if(prg.damB) prg.damB.breeding = false; if(prg.damC) prg.damC.breeding = false;
                            prg.litter.forEach(pup => { pup.id = Math.floor(Math.random()*100000); pup.cageHome=1; weaningRack.push(pup); }); pregnancies.splice(i, 1);
                        }
                    }
                    if (marketWeeksLeft <= 0) { marketWeeksLeft = 12; manualRefreshesThisPeriod = 3; }
                }
            }
        }
    } catch(e) {}
}
