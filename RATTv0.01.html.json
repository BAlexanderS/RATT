        window.filterDams = function() {
            let sSel = document.getElementById("sel-sire"), dSelA = document.getElementById("sel-damA"), dSelB = document.getElementById("sel-damB"), dSelC = document.getElementById("sel-damC");
            let valSire = sSel ? sSel.value : "", valA = dSelA ? dSelA.value : "", valB = (dSelB && !dSelB.disabled) ? dSelB.value : "", valC = (dSelC && !dSelC.disabled) ? dSelC.value : "";
            let usedIds = [valSire, valA, valB, valC].filter(x => x !== "");

            let updateSelectOptions = function(selectEl, currentVal, isHarem) {
                if (!selectEl) return;
                let html = isHarem ? "<option value=''>None (Optional Harem)</option>" : "<option value=''>Choose Doe</option>";
                colony.forEach(r => {
                    if (r.sex === "Doe ♀") {
                        let isThisSelected = (r.id.toString() === currentVal);
                        let isUsedElsewhere = (usedIds.includes(r.id.toString()) && !isThisSelected);
