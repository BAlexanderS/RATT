<!-- PART 3 SECTION A START -->
    <script>
        
<!-- PART 10 START -->
function renderShowDashboard() {
    let container = document.getElementById("show-dashboard-view");
    if (!container) return;

    if (activeShowCircuits.length === 0) {
        generateWeeklyShowCalendar();
    }

    let html = `<h4>📅 Available Weekly Circuits</h4>`;
    activeShowCircuits.forEach(show => {
        html += `<div class="card" style="background:#1f1a18; border-color:#e5b38a; padding:12px;">
            <div style="display:flex; justify-content:space-between; align-items:center;">
                <strong>${show.title}</strong>
                <span class="badge" style="color:#6da374;">Fee: 💰 ${show.fee} Shil</span>
            </div>
            <p style="font-size:11px; color:#c48c6a; margin:4px 0 2px 0; font-weight:bold;">Requirements: ${show.desc}</p>`;

        if (!show.benchedRat) {
            html += `<div style="display:flex; gap:6px; margin-top:6px;">
                <select id="select-for-${show.id}" style="flex:1;"><option value="">Select Candidate</option>`;
            
            colony.forEach(rat => {
                let isEligible = checkGeneticEligibility(rat, show.type);
                if (isEligible) {
                    html += `<option value="${rat.id}">${rat.name} (${rat.age} Wks)</option>`;
                }
            });

            html += `</select>
                <button onclick="benchAnimalToCircuit('${show.id}')" style="padding:6px 12px; margin:0;">Enter</button>
            </div>`;
        } else {
            html += `<div style="background:#2c2523; padding:8px; border-radius:4px; margin-top:6px; font-size:12px; border:1px solid #4a3e3a;">
                ⏳ <strong>Benched Rat:</strong> ${show.benchedRat.name}<br>
                📋 <strong>Opponents Field:</strong> ${show.field.map(f => `${f.name} [${f.rattery}]`).join(", ")}
            </div>`;
        }
        html += `</div>`;
    });

    html += `<h4>📜 Tournament Circuit Logs</h4>
    <div style="background:#2c2523; padding:10px; border-radius:6px; font-size:12px; max-height:160px; overflow-y:auto; border:1px solid #4a3e3a;">`;
    if (benchedHistoryLogs.length === 0) {
        html += `<span style="opacity:0.5; font-style:italic;">No records benched this timeline...</span>`;
    } else {
        benchedHistoryLogs.forEach(log => { html += `<div style="border-bottom:1px dashed #4a3e3a; padding:4px 0;">${log}</div>`; });
    }
    html += `</div>`;

    container.innerHTML = html;
}

window.benchAnimalToCircuit = function(showId) {
    // Clean prompt stream: preserves existing breeder name, requests rattery brand registration only once
    if (!ratteryRegistered) {
        let rInput = prompt("Enter your Official Rattery Name to secure circuit credentials:");
        if (!rInput || !rInput.trim()) return alert("Registration is required to access circuit fields.");
        
        ratteryName = rInput.trim();
        ratteryRegistered = true;
        saveGame();
    }

    let show = activeShowCircuits.find(s => s.id === showId);
    let selector = document.getElementById(`select-for-${showId}`);
    if (!show || !selector || !selector.value) return alert("Please select a candidate!");
    if (shillings < show.fee) return alert("Insufficient Shillings!");

    let ratId = parseInt(selector.value);
    let rat = colony.find(r => r.id === ratId);
    if (!rat) return;

    shillings -= show.fee;
    rat.inShowCircuit = true;
    show.benchedRat = rat;

    let tempField = new Array();
    tempField.push({ name: "Squeakers", rattery: "Apex Lines", score: Math.floor(Math.random() * 20) + 70 });
    tempField.push({ name: "Whiskers", rattery: "Fancy Tails", score: Math.floor(Math.random() * 20) + 72 });
    tempField.push({ name: "Nibbles", rattery: "Mischief Co.", score: Math.floor(Math.random() * 20) + 68 });
    tempField.push({ name: "Shadow", rattery: "Titan Rodents", score: Math.floor(Math.random() * 20) + 75 });
    show.field = tempField;

    refreshUI();
}
