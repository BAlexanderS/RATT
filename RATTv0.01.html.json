setInterval(function() {
    clockTicks += 1; document.getElementById("time-fill").style.width = ((clockTicks / 400) * 100) + "%";
    if (clockTicks >= 400) {
        clockTicks = 0; 
        colony.forEach(r => { r.age += 1; }); 
        weaningRack.forEach(r => { r.age += 1; }); 
        pregnancies.forEach(p => { p.stage += 1; });
        
        // 🌾 Passive Automated Food Block Buffer Consumption Loop
        let globalFoodDrain = colony.length * 10; 
        inventory.ratFoodBlocks = Math.max(0, inventory.ratFoodBlocks - globalFoodDrain);

        // Degradation Lifespan Tick for Installed Mansion Toys & Room Playgrounds
        cages.forEach(c => {
            for(let s=0; s<5; s++) {
                if (c.slots[s] && c.slots[s] !== "Silent Running Wheel") {
                    c.slotDurability[s] = Math.max(0, c.slotDurability[s] - 1);
                    if (c.slotDurability[s] <= 0) { c.slots[s] = null; }
                }
            }
        });
        if (inventory.roomFloorItem) {
            inventory.roomFloorDurability = Math.max(0, inventory.roomFloorDurability - 2);
            if (inventory.roomFloorDurability <= 0) { inventory.roomFloorItem = null; }
        }

        // Secure Auto-Weaning: Forcefully moves them to the rack only when they hit 5 weeks old
        for(let i = pregnancies.length - 1; i >= 0; i--) { 
            if (pregnancies[i].stage >= 5) { 
                weanLitter(i); 
            } 
        }

        // Exact Week-Shift Circuit Resolution: Triggers judging right at the zero-out boundary frame
        if (typeof resolveBenchedShowsTimeline === "function") { resolveBenchedShowsTimeline(); }

        if (weaningRack.length > 1) {
            let eligibleMales = weaningRack.filter(p => p.sex === "Buck ♂" && p.age >= 6);
            let eligibleFemales = weaningRack.filter(p => p.sex === "Doe ♀" && p.age >= 6);
            if (eligibleMales.length > 0 && eligibleFemales.length > 0 && pregnancies.length < matCapacity && Math.random() < 0.20) {
                let sire = eligibleMales[Math.floor(Math.random()*eligibleMales.length)];
                let dam = eligibleFemales[Math.floor(Math.random()*eligibleFemales.length)];
                weaningRack = weaningRack.filter(x => x.id !== sire.id && x.name !== sire.name);
                weaningRack = weaningRack.filter(x => x.id !== dam.id && x.name !== dam.name);
                
                sire.age = Math.max(12, sire.age); dam.age = Math.max(12, dam.age); 
                sire.breeding = true; dam.breeding = true;
                sire.id = colony.length + 1; colony.push(sire);
                dam.id = colony.length + 1; colony.push(dam); 
                
                let arr = new Array();
                let count = Math.floor(Math.random()*4)+3;
                for(let i=1; i<=count; i++) {
                    let rolledSm = cross(sire.silvermane, dam.silvermane);
                    if (rolledSm.filter(x => x === "Sm").length === 2) continue;

                    arr.push({ id: Math.floor(Math.random()*100000), name: "Accident #" + Math.floor(Math.random()*900+100), sex: Math.random() < 0.5 ? "Buck ♂" : "Doe ♀", age: 3, color: cross(sire.color, dam.color), d_blue: cross(sire.d_blue, dam.d_blue), rb_blue: cross(sire.rb_blue, dam.rb_blue), choc: cross(sire.choc, dam.choc), mink: cross(sire.mink, dam.mink), p_dilute: cross(sire.p_dilute, dam.p_dilute), r_dilute: cross(sire.r_dilute, dam.r_dilute), c: cross(sire.c, dam.c), coat: sire.coat === dam.coat ? sire.coat : "Standard", burmese: cross(sire.burmese, dam.burmese), be: cross(sire.be, dam.be), silvermane: rolledSm, harley: cross(sire.harley, dam.harley), bristle: cross(sire.bristle, dam.bristle), downunder: cross(sire.downunder, dam.downunder), marking_h: cross(sire.marking_h, dam.marking_h), headspot: cross(sire.headspot, dam.headspot), size_dw: cross(sire.size_dw, dam.size_dw), headspot_style: Math.random() < 0.5 ? "headspot" : "blazed", color_qm: blend(sire.color_qm, dam.color_qm), coat_qm: blend(sire.coat_qm, dam.coat_qm), behavior_qm: blend(sire.behavior_qm, dam.behavior_qm) });
                }
                pregnancies.push({ stage: 1, type: "⚠️ ACCIDENTAL LITTER", sire: sire, dam: dam, damB: null, damC: null, litter: arr });
                alert("⚠️ Management Notice! Grow out rack animals left past 6 weeks have accidentally bred!");
            }
        }
        marketWeeksLeft -= 1; if (marketWeeksLeft <= 0) { marketWeeksLeft = 12; manualRefreshesThisPeriod = 3; triggerServerMarketGeneration(); }
        
        // Drift free-roaming playground token positions randomly every week tick to simulate exploration
        let tokens = document.querySelectorAll(".rat-token");
