        </div>

        <div id="scr-store" class="screen">
            <h3>🎪 Supply Store & Rescue App</h3>
            <div style="background:#1f1a18; padding:10px; border-radius:6px; margin-bottom:10px; border:1px solid #4a3e3a;">
                <div style="display:flex; justify-content:space-between; font-weight:bold; font-size:12px; color:#e5b38a; margin-bottom:4px;">
                    <span>🎒 Rattery Supply Inventory Depot</span>
                    <span id="store-food-buffer-ui" style="color:#6da374;">Blocks Buffer: 0g</span>
