            let baseMutationThreshold = 0.00025; 
            if (sire.age > 52) { baseMutationThreshold *= (1 + (sire.age - 52) / 4); } 

            if (Math.random() < baseMutationThreshold) {
                let mutationRoll = Math.random();
                if (mutationRoll < 0.25) { childObj.coat = "Harley"; childObj.harley = ["hl","hl"]; }
                else if (mutationRoll < 0.50) { childObj.ears = ["du","du"]; }
