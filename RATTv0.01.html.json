    let html = `<strong>🆔 Specimen Handle:</strong> ${rat.name}<br>
                <strong>🧬 Biological Sex:</strong> ${rat.sex}<br>
                <strong>⏳ Chronological Age:</strong> ${rat.age} Weeks old<br>
