    let newId = cages.length + 1;
    cages.push({ id: newId, name: "Mischief Mansion Unit", genderRule: "Open", slots: new Array(null,null,null,null,null), slotDurability: new Array(0,0,0,0,0) });
    saveGame(); 
}

