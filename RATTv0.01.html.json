                <strong>📊 Rattery Quality Metrics:</strong><br>
                • Color Presentation Score: <span style="color:#e5b38a;">${rat.color_qm} / 100</span><br>
                • Coat Condition Score: <span style="color:#e5b38a;">${rat.coat_qm} / 100</span><br>
                • Temperament & Behavior: <span style="color:#e5b38a;">${rat.behavior_qm} / 100</span><br>
                <hr style="border:0; border-top:1px dashed #4a3e3a; margin:8px 0;">
                <strong>🏠 Housing Mansion Slot:</strong> Assigned to Mansion Unit #${rat.cageHome || 1}<br>
                <strong>📋 Operational Status:</strong> ${rat.breeding ? "🔬 Occupying Breeding Selector Rack" : (rat.inShowCircuit ? "🏆 Benched on competitive Circuit Field" : "🏡 Running out in Free-Roam Layout Floor")}`;

    if (rat.dnaRevealed) {
        html += `<br><span style="color:#6da374; font-size:11px; font-weight:bold;">🔬 Revealed DNA Sequence: [C:${rat.c.join("/")} | A:${rat.color.join("/")} | Du:${rat.ears ? rat.ears.join("/") : "Du/Du"}]</span>`;
    }

    details.innerHTML = html;
    nameInput.value = rat.name;

    let retireBtn = document.getElementById("pop-retire-btn");
    retireBtn.onclick = function() {
        if (confirm(`Are you sure you want to permanently retire or adopt out ${rat.name}?`)) {
            let cashAmt = getDynamicAdoptionFee();
            shillings += cashAmt;
            colony = colony.filter(r => r.id !== rat.id);
            
            let cageOccupants = colony.filter(r => r.cageHome === rat.cageHome).length;
            if (cageOccupants === 0) {
                let parentCage = cages.find(c => c.id === rat.cageHome);
                if (parentCage) parentCage.genderRule = "Open";
            }
            
            closeProfileCard();
            saveGame();
            alert(`🏡 Adopted Out! ${rat.name} found a happy companion pet placement. (+💰 ${cashAmt} Shil)`);
        }
    };

    pop.style.display = "block";
}

