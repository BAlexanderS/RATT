function getRosterFootprintCount() { return colony.length; }

window.graduate = function(i) { 
    let s = weaningRack[i]; 
    let targetCage = cages.find(c => c.genderRule === "Open" || c.genderRule === (s.sex === "Buck ♂" ? "Male Only" : "Female Only"));
    if (!targetCage) return alert("❌ No available housing slots matching this specimen's gender lines! Purchase or clear a Mischief Mansion.");
    
    let currentOccupantsCount = colony.filter(r => r.cageHome === targetCage.id).length;
    if (currentOccupantsCount >= 6) return alert(`🏠 Mischief Mansion #${targetCage.id} is full! (6/6 Rats)`);

    if (targetCage.genderRule === "Open") {
        targetCage.genderRule = (s.sex === "Buck ♂" ? "Male Only" : "Female Only");
    }

    s.id = colony.length + Math.floor(Math.random() * 1000) + 1; 
    s.cageHome = targetCage.id;
    s.inShowCircuit = false;
    colony.push(s); 
    weaningRack.splice(i, 1); 
    saveGame(); 
}

window.adopt = function(i) { 
    shillings += getDynamicAdoptionFee(); 
    reputation += Math.floor(weaningRack[i].behavior_qm / 4); 
    weaningRack.splice(i, 1); 
    saveGame(); 
}

