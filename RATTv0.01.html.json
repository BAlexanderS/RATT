    let box = document.getElementById("cage-move-buttons-box");
    if (!box) return; box.innerHTML = "";

    cages.forEach(c => {
        let count = colony.filter(r => r.cageHome === c.id).length;
        let isCurrent = (rat.cageHome === c.id);
        let validGender = (c.genderRule === "Open" || c.genderRule === (rat.sex === "Buck ♂" ? "Male Only" : "Female Only"));
        let btn = document.createElement("button");
        btn.innerText = `🏠 Move to Mansion #${c.id} (${count}/6 Rats) [${c.genderRule}]`;
        if (isCurrent || count >= 6 || !validGender) btn.disabled = true;

        btn.onclick = function() {
            let oldCageId = rat.cageHome;
            rat.cageHome = c.id;
            if (c.genderRule === "Open") { c.genderRule = (rat.sex === "Buck ♂" ? "Male Only" : "Female Only"); }
            
            let oldOccupants = colony.filter(r => r.cageHome === oldCageId).length;
            if (oldOccupants === 0) {
                let oldCage = cages.find(cg => cg.id === oldCageId);
                if (oldCage) oldCage.genderRule = "Open";
            }
            document.getElementById("cage-move-popup").style.display = "none";
            closeProfileCard(); saveGame();
            alert(`🚚 Moved ${rat.name} safely to Mansion #${c.id}.`);
