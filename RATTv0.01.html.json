function buildHeterozygousConfig(trait, config, chosenCoatLabel) {
    if (trait.type === "coat" && trait.rec !== "Hairless") chosenCoatLabel = trait.rec;
    else if (trait.type === "bristle") config.bristle = ["Br","br"];
    else if (trait.type === "silvermane") config.silvermane = ["Sm","sm"];
    else if (trait.type === "harley") config.harley = ["Hl","hl"];
    else if (trait.type === "size") config.size_dw = ["Dw","dw"];
    else if (trait.type === "ears") config.ears = ["Du","du"];
    else if (trait.type === "downunder") config.downunder = ["Hdu","hdu"];
    else if (trait.type === "headspot") config.headspot = ["Hs","hs"];
    else if (trait.type === "modifier") {
        if (trait.id === "burmese") config.burmese = ["Bu","bu"];
        if (trait.id === "black_eyed") config.be = ["Be","be"];
    }
    else if (trait.type === "dilute") {
        if (trait.id === "blue") config.d_blue = ["D","d"];
        if (trait.id === "russian_blue") config.rb_blue = ["Rb","rb"];
        if (trait.id === "mink") config.mink = ["M","m"];
        if (trait.id === "chocolate") config.choc = ["B","b"];
        if (trait.id === "ped") config.p_dilute = ["P","p"];
        if (trait.id === "red") config.r_dilute = ["R","r"];
    }
    else if (trait.type === "c_locus") {
        if (trait.id === "c_siamese") config.c = ["C","c^h"];
        if (trait.id === "c_albino") config.c = ["C","c"];
        if (trait.id === "c_marten") config.c = ["C","c^m"];
        if (trait.id === "c_tonkinese") config.c = ["C","c^t"];
    }
    else if (trait.type === "pattern") {
        if (trait.id === "h_hooded") config.marking_h = ["H","h"];
        if (trait.id === "h_irish") config.marking_h = ["H","h^i"];
        if (trait.id === "h_berkshire") config.marking_h = ["H","h"];
    }
}

function renderMarketCard(sList, rolledColorAlleles, config, chosenCoatLabel, totalPoints, tierLabel, forceSex) {
    let sRoll = forceSex ? forceSex : (Math.random() < 0.5 ? "Buck ♂" : "Doe ♀");
    let isFree = (onboardStage < 3); 
    let price = isFree ? 0 : (totalPoints === 3 ? 120 : (totalPoints === 2 ? 75 : 40));

    let mock = { 
        id: Math.floor(Math.random() * 100000) + 100, 
        name: "Rescue " + (sRoll === "Buck ♂" ? "Buck" : "Doe"), sex: sRoll, age: 12, breeding: false, inShowCircuit: false,
        color: rolledColorAlleles, d_blue: config.d_blue, rb_blue: config.rb_blue, choc: config.choc, mink: config.mink, p_dilute: config.p_dilute, r_dilute: config.r_dilute, 
        c: config.c, coat: chosenCoatLabel, ears: config.ears, burmese: config.burmese, be: config.be, silvermane: config.silvermane, harley: config.harley,
        bristle: config.bristle, downunder: config.downunder, marking_h: config.marking_h, headspot: config.headspot, size_dw: config.size_dw,
        headspot_style: Math.random() < 0.5 ? "headspot" : "blazed", color_qm: 50, coat_qm: 50, behavior_qm: 60, cageHome: 1
    };

    let strCard = document.createElement("div"); 
    strCard.className = "card";
    // VERIFIED FIX: Attached explicit 'mock.' prefix to the bristle parameter argument chain below
    let dV = decode(mock.color, mock.d_blue, mock.rb_blue, mock.choc, mock.mink, mock.p_dilute, mock.r_dilute, mock.c, mock.coat, mock.burmese, mock.be, mock.silvermane, mock.harley, mock.bristle, mock.downunder, mock.marking_h, mock.headspot, mock.size_dw, mock.headspot_style, mock.ears);
    
    strCard.innerHTML = "<strong>" + mock.name + " (" + mock.sex + ")</strong> <span class='badge' style='background:#4a3e3a; color:#e5b38a;'>Points: " + totalPoints + " (" + tierLabel + ")</span><br><small style='color:var(--accent-color)'>Variety: " + dV + "</small><br>Cost: " + (isFree ? "<span style='color:var(--success-color)'>FREE FOUNDER</span>" : "💰 " + price + " Shil") + "<br>";
    
    let btn = document.createElement("button"); 
    btn.innerText = "Adopt Animal";
    btn.onclick = function() {
        if (!isFree && shillings < price) return alert("Need Shillings!"); 
        
        let targetCage = cages.find(c => c.genderRule === "Open" || c.genderRule === (mock.sex === "Buck ♂" ? "Male Only" : "Female Only"));
        if (!targetCage) return alert("❌ No available housing slots matching this specimen's gender lines! Purchase a new Mansion unit.");
        let currentOccupantsCount = colony.filter(r => r.cageHome === targetCage.id).length;
        if (currentOccupantsCount >= 6) return alert(`🏠 Mischief Mansion #${targetCage.id} is full! (6/6 Rats)`);

        if (targetCage.genderRule === "Open") {
            targetCage.genderRule = (mock.sex === "Buck ♂" ? "Male Only" : "Female Only");
        }

        if (!isFree) shillings -= price; 
        mock.cageHome = targetCage.id;
        colony.push(mock); 
        strCard.remove();
        
        if (onboardStage === 1) { 
            onboardStage = 2; 
            document.getElementById("onboard-banner").innerText = "📌 TUTORIAL: Female locked! Select your free founding Buck (Male) to complete setup!";
            triggerServerMarketGeneration(); 
        } else if (onboardStage === 2) { 
            onboardStage = 3; 
            let b = document.getElementById("onboard-banner"); 
            if (b) b.remove(); 
            triggerServerMarketGeneration(); 
            alert("🎉 Founders chosen!");
        } 
        saveGame();
    };
    strCard.appendChild(btn); 
    sList.appendChild(strCard);
}

window.tab = function(t, el) { 
    document.querySelectorAll(".screen").forEach(s => s.classList.remove("active")); 
    document.querySelectorAll(".tab").forEach(tab => tab.classList.remove("on")); 
    let tScr = document.getElementById("scr-" + t);
    if(tScr) tScr.classList.add("active"); 
    if(el) el.classList.add("on"); 
}

localStorage.clear();
loadGame(); 
triggerServerMarketGeneration(); 
refreshUI();
<!-- PART 9 END -->

<!-- PART 11 START -->
function resolveBenchedShowsTimeline() {
    activeShowCircuits.forEach(show => {
        if (!show.benchedRat) return;

        let rat = show.benchedRat;
        lifetimeBenched += 1;

        let baseScore = Math.floor((rat.color_qm + rat.coat_qm) / 2);
        let playerFinalScore = Math.min(100, baseScore + Math.floor(Math.random() * 11 - 5));

        let rankPlacement = 1;
        show.field.forEach(opponent => {
            if (opponent.score > playerFinalScore) rankPlacement++;
        });

        let payoutShil = show.stipend;
        let repPayout = 20;
        let ribbonAwarded = null;
        let placementText = "";

        if (rankPlacement === 1) {
            lifetimeFirst += 1;
            repPayout = 120;
            payoutShil += 60;
            if (Math.random() < 0.35) {
                lifetimeBIS += 1;
                ribbonAwarded = "👑 Best In Show (BIS) Ribbon";
                placementText = "🏆 FIRST PLACE & BEST IN SHOW";
            } else {
                ribbonAwarded = "🥇 1st Place Blue Ribbon";
                placementText = "🥇 FIRST PLACE";
            }
        } else if (rankPlacement === 2) {
            lifetimeSecond += 1;
            repPayout = 60;
            payoutShil += 30;
            ribbonAwarded = "🥈 2nd Place Red Ribbon";
            placementText = "🥈 SECOND PLACE";
        } else if (rankPlacement === 3) {
            lifetimeThird += 1;
            repPayout = 30;
            payoutShil += 15;
            ribbonAwarded = "🥉 3rd Place Yellow Ribbon";
            placementText = "🥉 THIRD PLACE";
        } else {
            placementText = `🎟️ Benched Rank # ${rankPlacement}`;
        }

        shillings += payoutShil;
        reputation += repPayout;
        
        let logMsg = `<strong>${placementText}:</strong> ${rat.name} scored ${playerFinalScore} pts at ${show.title}. (+💰 ${payoutShil} Shil, +💖 ${repPayout} Rep)`;
        if (ribbonAwarded) {
            wonRibbonsInventory.push(ribbonAwarded);
            logMsg += ` Awarded: ${ribbonAwarded}!`;
        }
        benchedHistoryLogs.unshift(logMsg);

        rat.inShowCircuit = false;
        show.benchedRat = null;
        show.field = new Array();
    });
}

// Initial engine layout rendering call on bootup once document parses completely
renderShowDashboard();
</script>
