                        let vName = decode(r.color, r.d_blue, r.rb_blue, r.choc, r.mink, r.p_dilute, r.r_dilute, r.c, r.coat, r.burmese, r.be, r.silvermane, r.harley, r.bristle, r.downunder, r.marking_h, r.headspot, r.size_dw, r.headspot_style, r.ears);
