                alert(`🌾 Scatter fed grains into Mansion #${rat.cageHome}! occupants boosted.`);
            }
            closeItemUseModal(); closeProfileCard(); saveGame();
        };
        rowDiv.appendChild(useBtn); listEl.appendChild(rowDiv);
    });
    document.getElementById("item-use-popup").style.display = "block";
}
