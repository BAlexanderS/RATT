function executeMarketSpawnerLoop(sList, tierPools, forceSex) {
    for (let i = 1; i <= 3; i++) {
        let rRoll = Math.random(), totalPoints = 1, tierLabel = "Common";
        if (rRoll < 0.15) { totalPoints = 3; tierLabel = "Rare"; } 
        else if (rRoll < 0.45) { totalPoints = 2; tierLabel = "Uncommon"; }
        
        let baseColorRoll = Math.random();
        let rolledColorAlleles = ["A","A"];
        if (baseColorRoll < 0.30) rolledColorAlleles = ["a","a"];
        else if (baseColorRoll < 0.60) rolledColorAlleles = ["A","a"];

        let config = {
            d_blue: ["D","D"], rb_blue: ["Rb","Rb"], choc: ["B","B"], mink: ["M","M"], p_dilute: ["P","P"], r_dilute: ["R","R"],
            c: ["C","C"], coat: "Standard", ears: ["Du","Du"], burmese: ["bu","bu"], be: ["be","be"], silvermane: ["sm","sm"], harley: ["Hl","Hl"],
            bristle: ["br","br"], downunder: ["hdu","hdu"], marking_h: ["H","H"], headspot: ["Hs","Hs"], size_dw: ["Dw","Dw"]
        };

        let homoMax = 1, hetMax = 2;
        let assignedHomo = 0, assignedHet = 0;
        let chosenCoatLabel = "Standard";

        let availablePool = [...tierPools[tierLabel]];
        if (tierLabel === "Rare" || tierLabel === "Super Rare") {
            availablePool = availablePool.concat(tierPools["Uncommon"]).concat(tierPools["Common"]);
        } else if (tierLabel === "Uncommon") {
            availablePool = availablePool.concat(tierPools["Common"]);
        }
        
        let shuffledTraits = availablePool.sort(() => 0.5 - Math.random());

        for (let m = 0; m < totalPoints; m++) {
            let trait = shuffledTraits[m];
            if (!trait) continue;

            let rollHomo = (assignedHomo < homoMax && Math.random() < 0.50);
            
            if (rollHomo || assignedHet >= hetMax) {
                if (trait.type === "coat") chosenCoatLabel = trait.rec;
                else if (trait.type === "bristle") config.bristle = ["Br","Br"];
                else if (trait.type === "silvermane") config.silvermane = ["Sm","sm"]; // Locked to safe heterozygous
                else if (trait.type === "downunder") config.downunder = ["Hdu","hdu"]; // Locked to safe heterozygous
                else if (trait.type === "harley") config.harley = ["hl","hl"];
                else if (trait.type === "size") config.size_dw = ["dw","dw"];
                else if (trait.type === "ears") config.ears = ["du","du"];
                else if (trait.type === "headspot") config.headspot = ["hs","hs"];
                else if (trait.type === "modifier") {
                    if (trait.id === "burmese") config.burmese = ["Bu","Bu"];
                    if (trait.id === "black_eyed") config.be = ["Be","Be"];
                }
                else if (trait.type === "dilute") {
                    if (trait.id === "blue") config.d_blue = ["d","d"];
                    if (trait.id === "russian_blue") config.rb_blue = ["rb","rb"];
                    if (trait.id === "mink") config.mink = ["m","m"];
                    if (trait.id === "chocolate") config.choc = ["b","b"];
                    if (trait.id === "ped") config.p_dilute = ["p","p"];
                    if (trait.id === "red") config.r_dilute = ["r","r"];
                }
                else if (trait.type === "c_locus") {
                    if (trait.id === "c_siamese") config.c = ["c^h","c^h"];
                    if (trait.id === "c_albino") config.c = ["c","c"];
                    if (trait.id === "c_marten") config.c = ["c^m","c^m"];
                    if (trait.id === "c_himalayan") config.c = ["cc^h","cc^h"];
                    if (trait.id === "c_tonkinese") config.c = ["c^t","c^t"];
                    if (trait.id === "c_sable_tonk") config.c = ["c^t","c^t"];
                }
                else if (trait.type === "pattern") {
                    if (trait.id === "h_hooded") config.marking_h = ["h","h"];
                    if (trait.id === "h_irish") config.marking_h = ["h^i","h^i"];
                    if (trait.id === "h_berkshire") config.marking_h = ["H","h"];
                }
                assignedHomo++;
            } else {
                buildHeterozygousConfig(trait, config, chosenCoatLabel);
                assignedHet++;
            }
        }
        renderMarketCard(sList, rolledColorAlleles, config, chosenCoatLabel, totalPoints, tierLabel, forceSex);
    }
}
