    if(sSelectElement) sSelectElement.value = ""; if(dSelectElementA) dSelectElementA.value = ""; if(dSelectElementB) dSelectElementB.value = ""; if(dSelectElementC) dSelectElementC.value = "";
    refreshUI();
}

