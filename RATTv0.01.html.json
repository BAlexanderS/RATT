        function cross(s, d) { return [s[Math.floor(Math.random()*2)], d[Math.floor(Math.random()*2)]]; }
        function blend(s, d) { return Math.max(0, Math.min(100, Math.floor((s + d) / 2) + (Math.floor(Math.random()*7)-3))); }

        function decode(color, d_b, rb_b, ch, mk, pd, rd, c_loc, coat, burmese, be, sm, hl, br, downunder, marking_h, hs, size_dw, headspot_style, ears) {
            let c_code = [...c_loc].sort().join("");
            let has_be = (be.includes('Be') && c_code !== "CC");
            let base = "Black";
            let is_agouti = color.includes('A');
            let is_blue = (d_b.filter(x=>x==='d').length===2);
            let is_rb = (rb_b.filter(x=>x==='rb').length===2);
            let is_mink = (mk.filter(x=>x==='m').length===2);
            let is_choc = (ch.filter(x=>x==='b').length===2);
            let is_ped = (pd.filter(x=>x==='p').length===2);
            let is_red = (rd.filter(x=>x==='r').length===2);

            if (is_blue && is_rb) base = "Russian Silver";
            else if (is_mink && is_blue) base = "Platinum";
            else if (is_mink && is_ped) base = "Dove";
            else if (is_mink && is_choc) base = "Burnt Mink";
            else if (is_blue) base = "Blue";
            else if (is_rb) base = "Russian Blue";
            else if (is_mink) base = is_agouti ? "Cinnamon" : "Mink";
            else if (is_choc) base = "Chocolate";
            else if (is_ped) base = is_agouti ? "Amber" : "Champagne";
            else if (is_red) base = is_agouti ? "Fawn" : "Beige";
            else if (is_agouti) base = "Agouti";

            if (is_agouti && base !== "Agouti" && base !== "Cinnamon" && base !== "Amber" && base !== "Fawn" && base !== "Russian Silver" && base !== "Platinum" && base !== "Dove" && base !== "Burnt Mink") {
                base = base + " Agouti";
            }

            let c_mod = "";
            let buCount = burmese.filter(x => x === "Bu").length;
            if (c_code === "c^hc^h") {
                c_mod = "Siamese";
                if (buCount === 2) c_mod = "Sable";
                else if (buCount === 1) c_mod = "Burmese";
                if (has_be) c_mod = "Black Eyed " + c_mod;
            } else if (c_code === "cc^h") {
                c_mod = has_be ? "Black Eyed Himalayan" : "Himalayan";
                if (buCount === 1) c_mod = "Himalayan Burmese";
            } else if (c_code === "c^mc^m") {
                c_mod = has_be ? "Black Eyed Marten" : "Marten";
                if (buCount === 1) c_mod = "Marten Burmese";
                base = is_agouti ? "Agouti Marten" : "Black Marten";
            } else if (c_code === "c^tc^t") {
                c_mod = buCount === 2 ? "Sable Tonkinese" : "Tonkinese";
            }

            let finalColor = c_mod ? c_mod : base;
            if (c_code === "cc" && has_be) finalColor = "Black Eyed White";
            else if (c_code === "cc") finalColor = "Albino";

            let h_code = [...marking_h].sort().join("");
            let pattern = "";
            let is_du_spotted = (downunder && downunder.includes("Hdu"));

            if (h_code === "hh") { pattern = is_du_spotted ? "Downunder Hooded" : "Hooded"; } 
            else if (h_code === "h^ih^i" || h_code === "h^ih") { pattern = "Irish"; } 
            else if (h_code === "Hh") { pattern = is_du_spotted ? "Downunder Berkshire" : "Berkshire"; } 
            else if (is_du_spotted) { pattern = "Downunder"; }

            if (hs.filter(x => x === 'hs').length === 2 && c_code !== "cc") {
                let facialText = (headspot_style === "blazed") ? "Blazed" : "Headspot";
                pattern = pattern ? facialText + " " + pattern : facialText;
            }
            if (pattern && c_code !== "cc") finalColor = finalColor + " " + pattern;

            let traits = new Array();
            if (coat === "Hairless") traits.push("Hairless");
            else {
                if (coat === "Double Rex") traits.push("Double Rex");
                else if (coat === "Rex") traits.push("Rex");
                if (coat === "Double Velveteen") traits.push("Double Velveteen");
                else if (coat === "Velveteen") traits.push("Velveteen");
                if (coat === "Satin") traits.push("Satin");
            }

            let brCount = br.filter(x=>x==='Br').length;
            if (brCount === 2) traits.push("Double Bristlecoat");
            else if (brCount === 1) traits.push("Bristlecoat");

            if (sm.includes('Sm') && sm.includes('sm')) traits.push("Silvermane");
            if (hl.filter(x => x === 'hl').length === 2) traits.push("Harley");
            if (ears && ears.filter(x=>x==='du').length === 2) traits.push("Dumbo");

            let coatType = traits.length > 0 ? traits.join(" ") : "Standard";
            let sizePrefix = (size_dw.filter(x=>x==='dw').length === 2) ? "Dwarf " : "";

            return sizePrefix + finalColor + " (" + coatType + ")";
        }
