        function getDynamicPlayerTitleInfo() {
            let lvl = Math.floor(Math.sqrt(reputation / 100)) + 1;
            let title = "Novice Hobbyist";
            if (lvl >= 6) title = "Registered Exhibitor";
            if (lvl >= 11) title = "Sanctioned Breeder";
            if (lvl >= 16) title = "Master Exhibitor";
            if (lvl >= 21) title = "Grand Master Breeder";
            return { level: lvl, title: title };
        }

        function getDynamicAdoptionFee() {
            let pInfo = getDynamicPlayerTitleInfo();
            if (pInfo.level < 5) {
                return Math.min(45, 20 + Math.floor(reputation / 20));
            } else if (pInfo.level < 10) {
                return Math.min(65, 45 + Math.floor((reputation - 500) / 50));
            } else if (pInfo.level < 15) {
                return Math.min(85, 65 + Math.floor((reputation - 1500) / 125));
            } else {
                return Math.min(130, 85 + Math.floor((reputation - 4000) / 300));
            }
        }

